{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pwa-justworship",
  "compatibility_date": "2026-07-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Раніше теку підставляв `@cloudflare/vite-plugin`; його прибрано, тож
    // тепер указуємо явно — це звичайний вивід `vite build`.
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
